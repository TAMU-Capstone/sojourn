    {
      "id": "code-recorder",
      "title": "Halt the runaway recorder",
      "brief": "Patch the recorder task's code so the archive buffer empties and stays empty, without switching off instruments or changing the recorder's configuration.",
      "points": 25,
      "success": {
        "op": "sustained",
        "frames": 3,
        "of": {
          "op": "all",
          "of": [
            {
              "op": "mem_changed",
              "at": {
                "sym": "task_recorder"
              },
              "len": 124
            },
            {
              "op": "mem_u16",
              "at": {
                "sym": "g_rec_fill"
              },
              "cmp": "eq",
              "value": 0
            },
            {
              "op": "not",
              "of": {
                "op": "mem_changed",
                "at": {
                  "sym": "g_config",
                  "field": "rec_enable"
                },
                "len": 8
              }
            },
            {
              "op": "not",
              "of": {
                "op": "mem_changed",
                "at": {
                  "sym": "poll_enable",
                  "offset": 1
                },
                "len": 5
              }
            },
            {
              "op": "mem_bits",
              "at": {
                "addr": "0x2001E010"
              },
              "width": 4,
              "mask": 1,
              "cmp": "eq",
              "value": 1
            },
            {
              "op": "mem_bits",
              "at": {
                "addr": "0x2001E020"
              },
              "width": 4,
              "mask": 1,
              "cmp": "eq",
              "value": 1
            },
            {
              "op": "mem_bits",
              "at": {
                "addr": "0x2001E030"
              },
              "width": 4,
              "mask": 1,
              "cmp": "eq",
              "value": 1
            },
