              "at": {
                "addr": "0x2001E040"
              },
              "width": 4,
              "mask": 1,
              "cmp": "eq",
              "value": 1
            },
            {
              "op": "mem_bits",
              "at": {
                "addr": "0x2001E050"
              },
              "width": 4,
              "mask": 1,
              "cmp": "eq",
              "value": 1
            },
            {
              "op": "not",
              "of": {
                "op": "mem_changed",
                "at": {
